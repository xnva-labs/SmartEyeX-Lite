<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A0A0A"
    android:padding="16dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_revert"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:tint="#00E5FF" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📖 LIFE JOURNAL"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#00E5FF"
            android:gravity="center"
            android:fontFamily="monospace"
            android:letterSpacing="0.1" />

        <View android:layout_width="40dp" android:layout_height="40dp" />

    </LinearLayout>

    <!-- Tombol Generate -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <Button
            android:id="@+id/generateDailyButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="📅 DAILY"
            android:backgroundTint="#00E5FF"
            android:textColor="#0A0A0A"
            android:textStyle="bold"
            android:layout_marginEnd="4dp"
            android:textSize="12sp" />

        <Button
            android:id="@+id/generateMonthlyButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="📊 500 CHAT"
            android:backgroundTint="#D500F9"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:textSize="11sp" />

        <Button
            android:id="@+id/generateFullButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="🗂️ FULL"
            android:backgroundTint="#FF0266"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginStart="4dp"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- Loading Panel -->
    <LinearLayout
        android:id="@+id/loadingPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="@drawable/bg_cyber_card"
        android:visibility="gone"
        android:layout_marginBottom="16dp">

        <ProgressBar
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:indeterminateTint="#00E5FF" />

        <TextView
            android:id="@+id/loadingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Membuat ringkasan..."
            android:textColor="#00E5FF"
            android:layout_marginTop="12dp"
            android:fontFamily="monospace" />

    </LinearLayout>

    <!-- Empty State -->
    <TextView
        android:id="@+id/emptyText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="50dp"
        android:text="📭 Belum ada journal.\nKlik tombol DAILY, 500 CHAT, atau FULL untuk membuat ringkasan!"
        android:textColor="#666666"
        android:textSize="14sp"
        android:gravity="center"
        android:fontFamily="monospace"
        android:visibility="visible" />

    <!-- Journal List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/journalRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

</LinearLayout>