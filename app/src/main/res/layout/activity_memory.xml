<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A0A0A"
    android:padding="16dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_revert"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:tint="#00E5FF" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🧠 MEMORY VAULT"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#00E5FF"
            android:gravity="center"
            android:fontFamily="monospace"
            android:letterSpacing="0.1" />

        <View android:layout_width="40dp" android:layout_height="40dp" />

    </LinearLayout>

    <!-- Search Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_cyber_card"
        android:padding="4dp">

        <EditText
            android:id="@+id/searchInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="🔍 Cari percakapan..."
            android:textColor="#FFFFFF"
            android:textColorHint="#666666"
            android:background="@null"
            android:padding="12dp"
            android:fontFamily="monospace" />

        <ImageButton
            android:id="@+id/clearSearchButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:tint="#666666"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Empty State -->
    <TextView
        android:id="@+id/emptyText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="50dp"
        android:text="📭 Belum ada percakapan. Ajak SmartEyeX ngobrol yuk!"
        android:textColor="#666666"
        android:textSize="14sp"
        android:gravity="center"
        android:fontFamily="monospace"
        android:visibility="gone" />

    <!-- Memory List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/memoryRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible" />

</LinearLayout>