<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"

    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <ImageButton
                android:id="@+id/backButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_menu_revert"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:tint="#00E5FF" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="👤 PROFILE"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#00E5FF"
                android:gravity="center"
                android:fontFamily="monospace"
                android:letterSpacing="0.1" />

            <View android:layout_width="40dp" android:layout_height="40dp" />

        </LinearLayout>

        <!-- Name Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#1A00E5FF"
            app:cardCornerRadius="16dp"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🏷️ WHAT SHOULD I CALL YOU?"
                    android:textColor="#00E5FF"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/nameInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Bung X"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#666666"
                    android:background="@null"
                    android:textSize="18sp"
                    android:fontFamily="monospace" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Interests Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#1AFF0266"
            app:cardCornerRadius="16dp"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎯 YOUR INTERESTS"
                    android:textColor="#FF0266"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/interestsInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Pisahkan dengan koma (contoh: AI, Coding, Startup)"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#666666"
                    android:background="@null"
                    android:textSize="14sp"
                    android:fontFamily="monospace" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Personality Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#1AD500F9"
            app:cardCornerRadius="16dp"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎭 AI PERSONALITY"
                    android:textColor="#D500F9"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="8dp" />

                <Spinner
                    android:id="@+id/personalitySpinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Voice Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#1A00E5FF"
            app:cardCornerRadius="16dp"
            android:padding="16dp"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🔊 VOICE RESPONSE"
                    android:textColor="#00E5FF"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.05" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/voiceSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/resetButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="↺ RESET"
                android:backgroundTint="#FF0266"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/saveButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="2"
                android:text="💾 SAVE PROFILE"
                android:backgroundTint="#00E5FF"
                android:textColor="#0A0A0A"
                android:textStyle="bold"
                android:layout_marginStart="8dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>